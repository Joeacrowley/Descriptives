library(dplyr); library(tibble)
set.seed(1)
example_data <- tibble(
score    = c(rnorm(40, 60, 12), rnorm(40, 45, 12)),
approve  = factor(sample(c("Yes", "No"), 80, replace = TRUE, prob = c(0.6, 0.4))),
region   = factor(rep(c("North", "South"), each = 40)),
wt       = runif(80, 0.7, 1.4)
)
example_design <- example_data %>% srvyr::as_survey_design(ids = 1, weights = wt)
direct <- calc_stats(example_design, outcomes = "approve", predictors = "region",
statistics = "w_perc", conf = "se", pairwise = TRUE)
cat("---- direct calc_stats() ----\n")
print(direct %>% select(cross_break, p_cat1, estimate, sig_letter, sig_diff))
via_wrapper <- make_table(example_design, outcomes = "approve", predictors = "region",
statistics = "w_perc", conf = "se", pairwise = TRUE,
formatted = FALSE)
cat("---- make_table(formatted = FALSE), pivot_result[[1]] ----\n")
print(via_wrapper[[1]] %>% select(any_of(c("Variable","Statistics","Total","North","South")), matches("sigdiff")))
cat("---- make_table(formatted = FALSE), pivot_result[[6]] (legend) ----\n")
print(via_wrapper[[6]])
format_crosstab(via_wrapper)
library(dplyr)
library(tidyr)
library(purrr)
library(stringr)
