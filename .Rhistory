library(tidyverse)
library(srvyr)
df2    <- readRDS(here::here("data", "synthetic_bsa_clean.rds"))
df_svy <- df2 %>% as_survey_design(weight = WtFactor)
calc_stats(
df_svy,
outcomes   = "libauth",
predictors = list("RAgeCat"),
statistics = "w_mean",
conf       = "se",
pairwise   = TRUE
) %>%
rmarkdown::paged_table()
result <- weighted_mean_svyby(df_svy, outcomes = "libauth", predictors = list("RAgeCat"), conf = "se")
result %>% glimpse()
# The covariance matrix for this whole (outcome, predictor set) block
result$covmat[[1]]
# Every row in this block carries the identical matrix, not a per-row slice of it
identical(result$covmat[[1]], result$covmat[[2]])
# Same svyby() call weighted_mean_svyby() makes internally - a tbl_svy design
# object doesn't work directly here, so its class gets stripped first
design <- df_svy %>%
filter(!is.na(libauth), !is.na(RAgeCat))
class(design) <- setdiff(class(design), "tbl_svy")
# na.rm = TRUE has to go into svyby() itself, not svymean() directly - svyby()
# passes it through via ... . Without it, svyby(FUN = svymean) silently
# returns NA for an ENTIRE group if the outcome has any NA at all, even after
# filtering above (weighted_mean_svyby() carries the same na.rm = TRUE for
